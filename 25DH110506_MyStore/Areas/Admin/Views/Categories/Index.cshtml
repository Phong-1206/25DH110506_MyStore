@model IEnumerable<_25DH110506_MyStore.Models.Category>

@{
    ViewBag.Title = "Index";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<h2>Danh mục sản phẩm</h2>

<p>
    @Html.ActionLink("Thêm mới", "Create", null, new {@class = "btn btn-success" })
</p>
<table class="table table-bordered table-hover">
    <thead class="table-dark">
        <tr>
            <th class="col-lg-8 col-md-4 col-sm-2">
                @*@Html.DisplayNameFor(model => model.CategoryName)*@
                Tên danh mục
            </th>
            <th class="col-lg-3 col-md-2 col-sm-1"></th>
        </tr>
    </thead>
    <tbody>


        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.CategoryName)
                </td>
                <td class="text-center">
                    <div class="d-flex flex-wrap gap-2">
                        @Html.ActionLink("Cập nhật", "Edit", new { id = item.CategoryID }, new { @class = "btn bg-warning" })
                        @Html.ActionLink("Xem chi tiết", "Details", new { id = item.CategoryID }, new { @class = "btn btn-info" })
                        @Html.ActionLink("Xóa", "Delete", new { id = item.CategoryID }, new { @class = "btn btn-danger" })
                    </div>
                </td>
            </tr>
        }
    </tbody>

</table>
