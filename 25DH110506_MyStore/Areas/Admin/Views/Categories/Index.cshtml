@model IEnumerable<_25DH110506_MyStore.Models.Category>

@{
    ViewBag.Title = "Index";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<h2>DANH MỤC SẢN PHẨM</h2>

<p>
    @Html.ActionLink("Thêm mới", "Create", null, new {@class = "btn btn-success" })
</p>
<table class="table col-lg-12 col-md-6 col-sm-3" style="border: 2px solid black; border-radius: 15px;">
    <tr>
        <th class="col-lg-8 col-md-4 col-sm-2">
            @*@Html.DisplayNameFor(model => model.CategoryName)*@
            Tên danh mục
        </th>
        <th class="col-lg-3 col-md-2 col-sm-1" ></th>
    </tr>

@foreach (var item in Model) {
    <tr>
        <td>
            @Html.DisplayFor(modelItem => item.CategoryName)
        </td>
        <td class="text-center">
            @Html.ActionLink("Cập nhật", "Edit", new { id=item.CategoryID }, new { @class = "btn btn-primary" }) 
            @Html.ActionLink("Xem chi tiết", "Details", new { id=item.CategoryID }, new { @class = "btn btn-primary" })
            @Html.ActionLink("Xóa", "Delete", new { id=item.CategoryID }, new { @class = "btn btn-danger" })
        </td>
    </tr>
}

</table>
