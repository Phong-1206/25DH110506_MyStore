@model IEnumerable<_25DH110506_MyStore.Models.Customer>

@{
    ViewBag.Title = "Index";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<h2>Khách hàng</h2>

<table class="table table-bordered table-hover">
    <thead class="table-dark">
        <tr>
            <th>
                Tên khách hàng
            </th>
            <th>
                Số điện thoại
            </th>
            <th>
                Email
            </th>
            <th>
                Địa chỉ
            </th>
            <th>
                Password
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.CustomerName)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.CustomerPhone)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.CustomerEmail)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.CustomerAddress)
                </td>
                <td>
                    Không hiển thị
                </td>
                <td>
                    <div class="d-flex flex-wrap gap-2">
                        @Html.ActionLink("Cập nhật", "Edit", new { id = item.CustomerID }, new { @class = "btn bg-warning" }) 
                        @Html.ActionLink("Xem chi tiết", "Details", new { id = item.CustomerID }, new { @class = "btn bg-info" }) 
                    </div>
                </td>
            </tr>
        }
    </tbody>
</table>
