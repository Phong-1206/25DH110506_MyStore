@model _25DH110506_MyStore.Models.ViewModel.ProductSearchVM
@using PagedList.Mvc;
<head>
    <style>
        img {
            width: 100%;
            height: 100px;
            object-fit: cover;
        }

        .pagination-container {
            display: flex;
            justify-content: center;
            margin-top: 40px; 
            margin-bottom: 40px;
        }

            .pagination-container ul.pagination {
                display: flex;
                list-style: none;
                padding: 0;
                margin: 0;
                gap: 8px; /* Khoảng cách giữa các nút số trang */
            }

                .pagination-container ul.pagination li {
                    display: inline-block;
                }

                    /* Style chung cho các nút (a và span) */
                    .pagination-container ul.pagination li a,
                    .pagination-container ul.pagination li span {
                        display: inline-block;
                        padding: 8px 16px;
                        font-size: 15px;
                        color: #333;
                        background-color: #fff;
                        border: 1px solid #dee2e6;
                        border-radius: 6px; /* Bo góc cho giống phong cách hiện đại */
                        text-decoration: none;
                        transition: all 0.2s ease-in-out;
                    }

                        .pagination-container ul.pagination li a:hover {
                            background-color: #f8f9fa;
                            color: #0d6efd; /* Màu xanh Bootstrap */
                            border-color: #0d6efd;
                        }
                    .pagination-container ul.pagination li.active span,
                    .pagination-container ul.pagination li.active a {
                        background-color: #0d6efd; /* Nền xanh */
                        color: #fff; /* Chữ trắng */
                        border-color: #0d6efd;
                        font-weight: bold;
                        cursor: default; 
                    }

                    .pagination-container ul.pagination li.disabled span,
                    .pagination-container ul.pagination li.disabled a {
                        color: #adb5bd;
                        background-color: #e9ecef;
                        border-color: #dee2e6;
                        pointer-events: none;
                    }

                    .pagination-container ul.pagination li.PagedList-skipToNext a,
                    .pagination-container ul.pagination li.PagedList-skipToPrevious a {
                        font-weight: bold;
                    }
    </style>
</head>

<!-- Hiển thị dsanh sách sản phẩm  -->


@if (Model.Products != null && Model.Products.Any())
{
    <h2>DANH SÁCH SẢN PHẨM</h2>
    <table class="table col-lg-12 col-md-6 col-sm-3" style="border: 2px solid black; border-radius: 15px;">
        <tr>
            <th>
                Tên sản phẩm
            </th>
            <th>
                Giá
            </th>
            <th>
                Hình ảnh

            </th>
            <th>
                Mô tả
            </th>
            <th>
                Danh mục
            </th>
            <th class="col-lg-3 col-md-2 col-sm-1"></th>
        </tr>

        @foreach (var item in Model.Products)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.ProductName)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.ProductPrice)
                </td>
                <td>
                    <img src="@Url.Content(item.ProductImage)" alt="Hình ảnh @Html.DisplayFor(modelItem => item.ProductName)" />

                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.ProductDescription)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Category.CategoryName)
                </td>
                <td>
                    @Html.ActionLink("Cập nhật", "Edit", new { id = item.ProductID }, new { @class = "btn btn-primary" })
                    @Html.ActionLink("Xem chi tiết", "Details", new { id = item.ProductID }, new { @class = "btn btn-primary" })
                    @Html.ActionLink("Xóa", "Delete", new { id = item.ProductID }, new { @class = "btn btn-danger" })
                </td>
            </tr>
        }

    </table>
    @*<div class="pagination-container navigation">
        @Html.PagedListPager(Model.Products, page => Url.Action("Index", new { page, searchTerm = Model.SearchTerm, 
       minPrice = Model.MinPrice, maxPrice = Model.MaxPrice, sortOrder = Model.SortOrder }))

    </div>*@
<div class="pagination-container navigation">
    @Html.PagedListPager(Model.Products, page => Url.Action("Index", new { page, searchTerm = Model.SearchTerm, minPrice = Model.MinPrice, maxPrice = Model.MaxPrice, sortOrder = Model.SortOrder }),
new PagedListRenderOptions
     {
    DisplayLinkToFirstPage = PagedListDisplayMode.IfNeeded,
    DisplayLinkToLastPage = PagedListDisplayMode.IfNeeded,
    MaximumPageNumbersToDisplay = 5,
    LinkToFirstPageFormat = "Đầu",
    LinkToLastPageFormat = "Cuối"
})
</div>

}
else
{
    <p>Không tìm thấy sản phẩm. </p>
}

<div class="form-group">

    <div class="col-md-offset-8 col-md-4">
        @Html.ActionLink("Thêm mới", "Create", null, new { @class = "btn btn-success" })
    </div>

</div>