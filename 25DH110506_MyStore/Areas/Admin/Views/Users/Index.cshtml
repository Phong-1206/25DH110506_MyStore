@model IEnumerable<_25DH110506_MyStore.Models.User>
@{
    ViewBag.Title = "Quản lý Tài khoản";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<h2>Quản lý Tài khoản Đăng nhập</h2>

<table class="table table-bordered table-hover mt-3">
    <thead class="table-dark">
        <tr>
            <th>Tên đăng nhập</th>
            <th>Quyền hạn</th>
            <th>Thao tác</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td><strong>@item.Username</strong></td>
                <td>
                    @if (item.UserRole == "A")
                    {
                        <span class="badge bg-danger">Admin (A)</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">Khách hàng (C)</span>
                    }
                </td>
                <td>
                    @using (Html.BeginForm("ChangeRole", "Users", FormMethod.Post, new { @class = "d-inline" }))
                    {
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="username" value="@item.Username" />
                        if (item.UserRole == "A")
                        {
                            <input type="hidden" name="newRole" value="C" />
                            <button type="submit" class="btn btn-sm btn-warning" onclick="return confirm('Hạ quyền Admin này xuống Khách hàng?')">Hạ quyền</button>
                        }
                        else
                        {
                            <input type="hidden" name="newRole" value="A" />
                            <button type="submit" class="btn btn-sm btn-success" onclick="return confirm('Nâng quyền Khách hàng này lên Admin?')">Nâng quyền</button>
                        }
                    }

                    @using (Html.BeginForm("Delete", "Users", FormMethod.Post, new { @class = "d-inline ms-2" }))
                    {
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="username" value="@item.Username" />
                        <button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('CẢNH BÁO: Bạn có chắc chắn muốn xóa tài khoản này?')">Xóa</button>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>