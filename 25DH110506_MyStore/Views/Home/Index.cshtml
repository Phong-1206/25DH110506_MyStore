@model _25DH110506_MyStore.Models.ViewModel.HomeProductVM
<link href="~/Content/myStyle/CustomerHome.css" rel="stylesheet" />
@{
    ViewBag.Title = "Customer Home Page";
}

@* Banner *@

<section class="container-fluid banner">
    <div class="banner-container">
        <h2>
            Chào mừng đến với cửa hàng của chúng tôi!
        </h2>
        <p>Mua sắm trực tuyến với hàng ngàn sản phẩm đa dạng và chất lượng </p>
        <a href="#" class="btnBanner">Bắt đầu mua hàng</a>
    </div>
</section>

<section class="container-fluid searchProd">
    <h2>Tìm kiếm sản phẩm</h2>
    @using (Html.BeginForm("Index", "Home", FormMethod.Get))
    {
        <div class="form-group search-container">
            @Html.TextBoxFor(m => m.SearchTerm, new { @class = "form-control", placeholder = "Tìm kiếm sản phẩm...", type = "text" })
            <button type="submit" class="btn btn-primary">Tìm kiếm</button>

        </div>
    }
</section>
<hr />

@Html.Partial("PVFeatureProduct", Model)

@Html.Partial("PVNewProduct", Model)