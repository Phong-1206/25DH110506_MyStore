@model _25DH110506_MyStore.Models.ViewModel.HomeProductVM
@using _25DH110506_MyStore.Helpers
@{
    Layout = null;
}

@if (Model.FeatureProducts != null && Model.FeatureProducts.Any())
{
    <section class="container-fluid featureProd">
        <h2> Sản phẩm nổi bật </h2>
        <div class="feature-container">
            @foreach (var product in Model.FeatureProducts)
            {
                <div class="fproduct-item">
                    <div class="div-img">
                        <a href="@Url.Action("ProductDetail", "Home", new { id = product.ProductID})">
                            <img class="img-layout" src="@Url.Content(product.ProductImage)" alt="Hình ảnh @Html.DisplayFor(modelItem => product.ProductName)" />
                        </a>
                    </div>
                    <div>
                        <p class="prodPrice">
                            @Html.Vnd(product.ProductPrice)  VNĐ
                        </p>
                        <p class="prodName">
                            @Html.DisplayFor(modelItem => product.ProductName)
                        </p>
                        <p class="prodCate">
                            @Html.DisplayFor(modelItem => product.Category.CategoryName)
                        </p>
                        <p class="prodSale">
                            Đã bán: &nbsp;@Html.DisplayFor(modelItem => product.OrderDetails.Count)
                        </p>
                    </div>
                </div>
            }

        </div>

    </section>

}
