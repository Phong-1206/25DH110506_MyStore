
@model _25DH110506_MyStore.Models.ViewModel.HomeProductVM

@using PagedList.Mvc;
@{
    Layout = null;
}
<link rel="stylesheet" href="~/Content/myStyle/pagination.css" />

@if (Model.NewProducts != null && Model.NewProducts.Any())
{
    <section class="container-fluid listProduct">
        <h2> Sản phẩm mới </h2>
        <ul class="list-container">
            @foreach (var product in Model.NewProducts)
            {
                <li class="lproduct-item">
                    <div class="div-img">
                        <a href="@Url.Action("ProductDetail", "Home", new {id = product.ProductID})">
                            <img class="img-layout" src="@Url.Content(product.ProductImage)" alt="Hình ảnh @Html.DisplayFor(modelItem => product.ProductName)" />
                        </a>
                    </div>
                    <div>
                        <p class="prodPrice">@Html.DisplayFor(modelItem => product.ProductPrice) VNĐ</p>
                        <p class="prodName">@Html.DisplayFor(modelItem => product.ProductName)</p>
                        <p class="prodSale">Đã bán: &nbsp;@Html.DisplayFor(modelItem => product.OrderDetails.Count)</p>
                    </div>
                </li>
            }
        </ul>
    </section>
    <div class="pagination-container pagination-sm-custom">
        @Html.PagedListPager(Model.NewProducts, page => Url.Action("Index", new {page, searchTerm = Model.SearchTerm}))

    </div>

}
else 
{
    <p>Không tìm được sản phẩm nào phù hợp. </p>
}
