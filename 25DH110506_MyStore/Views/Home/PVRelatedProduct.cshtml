@model _25DH110506_MyStore.Models.ViewModel.ProductDetailsVM

@using _25DH110506_MyStore.Helpers
@using PagedList.Mvc;
<link href="~/Content/myStyle/CustomerHome.css" rel="stylesheet" />

@if (Model.RelatedProducts != null && Model.RelatedProducts.Any())
{
    <section class="container-fluid featureProd">
        <h4 style="font-weight: bold;">Sản phẩm tương tự</h4>
        <ul class="feature-container">
            @foreach (var product in Model.RelatedProducts)
            {
                <li class="fproduct-item" style="list-style-type: none;">
                    <div class="div-img">
                        <a href="@Url.Action("ProductDetail", "Home", new {id = product.ProductID})">
                            <img class="img-layout" src="@Url.Content(product.ProductImage)" alt="Hình ảnh @Html.DisplayFor(modelItem => product.ProductName)" />
                        </a>
                    </div>
                    <div>
                        <h5 style="margin-left: 5px;">
                            @Html.DisplayFor(modelItem => product.ProductName)
                        </h5>
                        <p class="prodSale"> @Html.VndWithSymbol(product.ProductPrice)</p>
                    </div>

                </li>
            }

        </ul>

    </section>
}