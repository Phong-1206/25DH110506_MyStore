@model _25DH110506_MyStore.Models.ViewModel.ProductDetailsVM
@using PagedList.Mvc;


<link href="~/Content/myStyle/CustomerHome.css" rel="stylesheet" />

<link rel="stylesheet"  href="~/Content/myStyle/pagination.css"/>
@if (Model.TopProducts != null && Model.TopProducts.Any())
{
    <section class="container-fluid listProduct">
        <h4 style="font-weight: bold;">Sản phẩm bán chạy</h4>
        <ul class="list-container">
            @foreach (var product in Model.TopProducts) 
            {
                <li class="lproduct-item">
                    <div class="div-img">
                        <a href="@Url.Action("ProductDetail", "Home", new {id = product.ProductID})">
                            <img style="max-width: 100%; height:150px; border-radius: 10px;" src="@Url.Content(product.ProductImage)" alt="Hình ảnh @Html.DisplayFor(modelItem => product.ProductName)" />
                        </a>
                    </div>
                    <div>
                        <h5>@Html.DisplayFor(modelItem => product.ProductName)</h5>
                        <p class="prodSale">@Html.DisplayFor(modelItem => product.ProductPrice)</p>
                    </div>


                </li>
            }

        </ul>

    </section>
    <div class="pagination-container pagination-sm-custom">
        @Html.PagedListPager(Model.TopProducts, page => Url.Action("ProductDetail", new 
   { 
       id = Model.product.ProductID,
       quantity=Model.quantity, 
       page 
   }))

    </div>
}