@model _25DH110506_MyStore.Models.Order
@using _25DH110506_MyStore.Helpers
@{
    ViewBag.Title = "Chi tiết đơn hàng #" + Model.OrderID;
    Layout = "~/Views/Shared/_Layout.cshtml";
    var details = ViewBag.OrderDetails as List<_25DH110506_MyStore.Models.OrderDetail>;
}

<div class="container mt-4 mb-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Chi tiết đơn hàng #@Model.OrderID</h2>
        <a href="@Url.Action("MyOrders", "Order")" class="btn btn-outline-secondary">
             Quay lại danh sách
        </a>
    </div>

    <div class="row">
        <!-- Thông tin giao hàng -->
        <div class="col-md-5 mb-3">
            <div class="card shadow-sm h-100">
                <div class="card-header bg-dark text-white">
                    <strong>Thông tin giao hàng</strong>
                </div>
                <div class="card-body">
                    <p><strong>Người nhận:</strong> @Model.Customer.CustomerName</p>
                    <p><strong>Điện thoại:</strong> @Model.Customer.CustomerPhone</p>
                    <p><strong>Địa chỉ:</strong> @Model.AddressDelivery</p>
                    <p><strong>Ngày đặt:</strong> @Model.OrderDate.ToString("dd/MM/yyyy HH:mm")</p>
                    <p class="mb-0">
                        <strong>Trạng thái:</strong>
                        <span>@Model.PaymentStatus</span>
                    </p>
                </div>
            </div>
        </div>

        <div class="col-md-7 mb-3">
            <div class="card shadow-sm h-100">
                <div class="card-header bg-success text-white">
                    <strong>Thông tin thanh toán</strong>
                </div>
                <div class="card-body d-flex flex-column justify-content-center text-center">
                    <p class="mb-2 text-muted">Tổng số sản phẩm</p>
                    <h3 class="mb-3">@(details?.Sum(d => d.Quantity) ?? 0)</h3>
                    <p class="mb-2 text-muted">Tổng tiền</p>
                    <h2 class="text-danger fw-bold">@Html.VndWithSymbol(Model.TotalAmount)</h2>
                </div>
            </div>
        </div>
    </div>
    <div class="card shadow-sm mt-3">
        <div class="card-header bg-primary text-white">
            <strong>Sản phẩm trong đơn</strong>
        </div>
        <div class="table-responsive">
            <table class="table table-hover mb-0 align-middle">
                <thead>
                    <tr>
                        <th></th>
                        <th>Sản phẩm</th>
                        <th class="text-center">Đơn giá</th>
                        <th class="text-center">Số lượng</th>
                        <th class="text-end">Thành tiền</th>
                    </tr>
                </thead>
                <tbody>
                    @if (details != null && details.Any())
                    {
                        foreach (var item in details)
                        {
                            <tr>
                                <td>
                                    <img width="50px" height="50px" src="@item.Product.ProductImage" alt="Ảnh sản phẩm - @item.Product.ProductName"/>
                                </td>
                                <td>
                                    @if (item.Product != null)
                                    {
                                        <a href="@Url.Action("ProductDetails", "Home", new { id = item.ProductID })"
                                           class="text-decoration-none">
                                            @item.Product.ProductName
                                        </a>
                                    }
                                    else
                                    {
                                        <span class="text-muted">Sản phẩm đã bị xóa</span>
                                    }
                                </td>
                                <td class="text-center">@Html.VndWithSymbol(item.UnitPrice)</td>
                                <td class="text-center">@item.Quantity</td>
                                <td class="text-end fw-bold">@Html.VndWithSymbol(item.UnitPrice * item.Quantity)</td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr><td colspan="4" class="text-center text-muted py-4">Không có sản phẩm nào.</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>