@model IEnumerable<_25DH110506_MyStore.Models.Order>
@using _25DH110506_MyStore.Helpers
@{
    ViewBag.Title = "Đơn hàng của tôi";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4 mb-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Đơn hàng của tôi</h2>
        <a href="@Url.Action("Index", "Home")" class="btn btn-outline-secondary">
            ⬅️ Tiếp tục mua sắm
        </a>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info text-center py-5">
            <h4>Bạn chưa có đơn hàng nào</h4>
            <p>Hãy đặt đơn hàng đầu tiên của bạn ngay hôm nay!</p>
            <a href="@Url.Action("Index", "Home")" class="btn btn-warning mt-2">
                Mua sắm ngay
            </a>
        </div>
    }
    else
    {
        <div class="card shadow-sm">
            <div class="table-responsive">
                <table class="table table-hover mb-0 align-middle">
                    <thead class="table-dark">
                        <tr>
                            <th>Mã đơn</th>
                            <th>Ngày đặt</th>
                            <th>Địa chỉ giao</th>
                            <th>Tổng tiền</th>
                            <th>Trạng thái</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var order in Model)
                        {
                            <tr>
                                <td><strong>#@order.OrderID</strong></td>
                                <td>@order.OrderDate.ToString("dd/MM/yyyy HH:mm")</td>
                                <td style="max-width: 250px;">
                                    <small>@order.AddressDelivery</small>
                                </td>
                                <td class="text-danger fw-bold">
                                    @Html.VndWithSymbol(order.TotalAmount)
                                </td>
                                <td>
                                    @{
                                        string badgeClass = "bg-warning text-dark";
                                        if (order.PaymentStatus == "Đã giao") { badgeClass = "bg-success"; }
                                        else if (order.PaymentStatus == "Đã hủy") { badgeClass = "bg-danger"; }
                                        else if (order.PaymentStatus == "Đang giao hàng") { badgeClass = "bg-info text-dark"; }
                                    }
                                    <span class="badge @badgeClass">@order.PaymentStatus</span>
                                </td>
                                <td>
                                    <a href="@Url.Action("MyOrderDetails", "Order", new { id = order.OrderID })"
                                       class="btn btn-sm btn-outline-primary">
                                        Xem chi tiết
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>